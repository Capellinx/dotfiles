background-opacity = 0.9
background-blur-radius = 20
background = #1f2329
foreground = #a0a8b7

# onedark.nvim "darker" palette (matches nvim colorscheme)
palette = 0=#0e1013
palette = 1=#e55561
palette = 2=#8ebd6b
palette = 3=#e2b86b
palette = 4=#4fa6ed
palette = 5=#bf68d9
palette = 6=#48b0bd
palette = 7=#a0a8b7
palette = 8=#535965
palette = 9=#e55561
palette = 10=#8ebd6b
palette = 11=#e2b86b
palette = 12=#4fa6ed
